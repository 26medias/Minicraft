{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "build",
		"rootDir": "src"
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts", "src/testFixtures.ts", "src/fakeStorage.ts"]
}
