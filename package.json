{
	"name": "minicraft",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"prebuild": "npm run build-atlas",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"build-atlas": "tsx scripts/build-atlas.ts",
		"gen-catalog": "tsx scripts/gen-catalog.ts",
		"gen-server-catalog": "tsx scripts/gen-server-catalog.ts",
		"worldgen:kid": "tsx scripts/worldgen-kid.ts",
		"worldgen:check": "tsx scripts/worldgen-check.ts 1,2,3,5,8,13,21,34 && tsx scripts/worldgen-kid.ts 1,2,3,5,8,13,21,34",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint .",
		"perf:bench": "tsx scripts/perf-bench.ts",
		"smoke:crafting": "tsx scripts/crafting-smoke.ts",
		"smoke:menu": "tsx scripts/menu-smoke.ts",
		"e2e:mp": "tsx scripts/mp-e2e.ts",
		"format": "prettier --write ."
	},
	"dependencies": {
		"alea": "^1.0.1",
		"pako": "^2.1.0",
		"simplex-noise": "^4.0.3",
		"three": "^0.164.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/pako": "^2.0.3",
		"@types/three": "^0.164.0",
		"@typescript-eslint/eslint-plugin": "^8.59.0",
		"@typescript-eslint/parser": "^8.59.0",
		"@vitest/ui": "^4.1.5",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"playwright": "^1.47.0",
		"prettier": "^3.8.3",
		"sharp": "^0.33.0",
		"tsx": "^4.19.0",
		"typescript": "~5.6.0",
		"vite": "^5.4.0",
		"vitest": "^4.1.5"
	}
}
